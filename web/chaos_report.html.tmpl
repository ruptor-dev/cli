<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Ruptor Reliability Report</title>
<style>
  *, *::before, *::after { box-sizing: border-box; }
  body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    margin: 0; padding: 2rem; background: #f8f9fa; color: #1a1a1a; line-height: 1.5;
  }
  .container { max-width: 1200px; margin: 0 auto; }
  h1 { font-size: 1.5rem; font-weight: 600; margin: 0 0 0.25rem; }
  .subtitle { color: #6b7280; font-size: 0.875rem; margin-bottom: 1.5rem; }
  .summary {
    display: flex; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.5rem;
  }
  .card {
    background: #fff; border: 1px solid #e5e7eb; border-radius: 8px;
    padding: 1rem 1.25rem; min-width: 140px; flex: 1;
  }
  .card-label { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; color: #6b7280; margin-bottom: 0.25rem; }
  .card-value { font-size: 1.5rem; font-weight: 700; }
  .card-value.pass { color: #16a34a; }
  .card-value.fail { color: #dc2626; }
  table {
    width: 100%; border-collapse: collapse; background: #fff;
    border: 1px solid #e5e7eb; border-radius: 8px; overflow: hidden;
    font-size: 0.875rem;
  }
  thead { background: #f9fafb; }
  th {
    text-align: left; padding: 0.75rem 1rem; font-weight: 600;
    border-bottom: 2px solid #e5e7eb; white-space: nowrap;
  }
  td { padding: 0.75rem 1rem; border-bottom: 1px solid #f3f4f6; vertical-align: top; }
  tr:last-child td { border-bottom: none; }
  .status {
    display: inline-block; padding: 0.125rem 0.5rem; border-radius: 9999px;
    font-size: 0.75rem; font-weight: 600; text-transform: uppercase;
  }
  .status-pass { background: #dcfce7; color: #15803d; }
  .status-fail { background: #fee2e2; color: #b91c1c; }
  .behaviors { font-size: 0.8rem; color: #6b7280; }
  .error { color: #dc2626; font-size: 0.8rem; }
  .empty { color: #9ca3af; }
  @media (max-width: 640px) {
    body { padding: 1rem; }
    .summary { flex-direction: column; }
    table { display: block; overflow-x: auto; }
  }
</style>
</head>
<body>
<div class="container">
  <h1>Ruptor Reliability Report</h1>
  <p class="subtitle"><strong>Agent:</strong> {{.AgentName}} &middot; <strong>Run:</strong> {{.RunAt.Format "2006-01-02 15:04:05"}}</p>

  <div class="summary">
    <div class="card">
      <div class="card-label">Total Tests</div>
      <div class="card-value">{{.TotalTests}}</div>
    </div>
    <div class="card">
      <div class="card-label">Passed</div>
      <div class="card-value pass">{{.Passed}}</div>
    </div>
    <div class="card">
      <div class="card-label">Failed</div>
      <div class="card-value fail">{{.Failed}}</div>
    </div>
    <div class="card">
      <div class="card-label">Score</div>
      <div class="card-value">{{.Score}}%</div>
    </div>
  </div>

  <table>
    <thead>
      <tr>
        <th>Status</th>
        <th>Test ID</th>
        <th>Fault Type</th>
        <th>Tool</th>
        <th>Duration</th>
        <th>Behaviors</th>
        <th>Judge Verdict</th>
        <th>Judge Reason</th>
        <th>Error</th>
      </tr>
    </thead>
    <tbody>
      {{range .Results}}<tr>
        <td><span class="status {{if .Passed}}status-pass{{else}}status-fail{{end}}">{{if .Passed}}PASS{{else}}FAIL{{end}}</span></td>
        <td>{{.TestID}}</td>
        <td>{{.FaultType}}</td>
        <td>{{.Tool}}</td>
        <td>{{.DurationMs}}ms</td>
        <td class="behaviors">{{if .DetectedBehaviors}}{{range $i, $b := .DetectedBehaviors}}{{if $i}}, {{end}}{{$b}}{{end}}{{else}}<span class="empty">&mdash;</span>{{end}}</td>
        <td>{{if .LLMJudgeVerdict}}{{.LLMJudgeVerdict}}{{else}}<span class="empty">&mdash;</span>{{end}}</td>
        <td>{{if .LLMJudgeReason}}{{.LLMJudgeReason}}{{else}}<span class="empty">&mdash;</span>{{end}}</td>
        <td>{{if .Error}}<span class="error">{{.Error}}</span>{{else}}<span class="empty">&mdash;</span>{{end}}</td>
      </tr>{{end}}
    </tbody>
  </table>
</div>
</body>
</html>
