<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Ruptor Reliability Report — {{.AgentName}}</title>
<style>
  :root {
    --bg: #141008;
    --panel: #1d1810;
    --panel-2: #241d13;
    --border: #3a2f1e;
    --fg: #f1ece1;
    --muted: #8f8576;
    --primary: #e84545;
    --success: #22c55e;
    --warning: #f59e0b;
    --danger: #ef4444;
    --mono: ui-monospace, "SF Mono", Menlo, Consolas, "Liberation Mono", monospace;
  }
  *, *::before, *::after { box-sizing: border-box; }
  html, body { background: var(--bg); }
  body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    margin: 0; padding: 2.5rem 2rem 4rem; color: var(--fg); line-height: 1.55;
  }
  .container { max-width: 1100px; margin: 0 auto; }

  header.masthead {
    display: flex; align-items: baseline; gap: 0.75rem;
    border-bottom: 1px solid var(--border); padding-bottom: 1.25rem; margin-bottom: 2rem;
  }
  .brand {
    font-family: var(--mono); font-weight: 700; letter-spacing: 0.02em;
    color: var(--primary); font-size: 1rem; text-transform: uppercase;
  }
  .title { font-size: 1.05rem; font-weight: 500; color: var(--muted); margin: 0; }

  .score-card {
    background: linear-gradient(180deg, var(--panel) 0%, var(--panel-2) 100%);
    border: 1px solid var(--border); border-radius: 14px;
    padding: 2rem 2.25rem; margin-bottom: 1.5rem; position: relative;
  }
  .score-label {
    font-family: var(--mono); font-size: 0.72rem; letter-spacing: 0.18em;
    text-transform: uppercase; color: var(--muted); margin-bottom: 0.5rem;
  }
  .score-value { font-size: 4.25rem; font-weight: 700; line-height: 1; letter-spacing: -0.02em; }
  .score-value.good    { color: var(--success); }
  .score-value.mid     { color: var(--warning); }
  .score-value.bad     { color: var(--danger); }
  .score-detail { margin-top: 0.75rem; color: var(--muted); font-size: 0.95rem; }
  .score-detail strong { color: var(--fg); font-weight: 600; }

  .meta-row {
    display: flex; flex-wrap: wrap; gap: 2rem;
    background: var(--panel); border: 1px solid var(--border); border-radius: 10px;
    padding: 0.85rem 1.25rem; margin-bottom: 2rem;
    font-size: 0.87rem;
  }
  .meta-item { display: flex; flex-direction: column; }
  .meta-item .k {
    font-family: var(--mono); font-size: 0.68rem; letter-spacing: 0.15em;
    text-transform: uppercase; color: var(--muted);
  }
  .meta-item .v { color: var(--fg); margin-top: 0.2rem; }

  section h2 {
    font-size: 0.9rem; text-transform: uppercase; letter-spacing: 0.15em;
    color: var(--muted); margin: 0 0 0.75rem; font-weight: 600;
  }

  table {
    width: 100%; border-collapse: separate; border-spacing: 0;
    background: var(--panel); border: 1px solid var(--border); border-radius: 10px;
    overflow: hidden; font-size: 0.9rem;
  }
  thead th {
    text-align: left; padding: 0.85rem 1rem;
    font-family: var(--mono); font-size: 0.72rem; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--muted);
    background: var(--panel-2); border-bottom: 1px solid var(--border);
  }
  tbody td {
    padding: 0.85rem 1rem; border-bottom: 1px solid var(--border);
    vertical-align: top;
  }
  tbody tr:last-child td { border-bottom: none; }
  tbody tr:hover { background: rgba(232, 69, 69, 0.04); }

  .badge {
    display: inline-block; padding: 0.2rem 0.6rem; border-radius: 9999px;
    font-family: var(--mono); font-size: 0.7rem; letter-spacing: 0.08em;
    font-weight: 600; text-transform: uppercase;
  }
  .badge-pass { background: rgba(34, 197, 94, 0.14); color: var(--success); border: 1px solid rgba(34, 197, 94, 0.35); }
  .badge-fail { background: rgba(239, 68, 68, 0.14); color: var(--danger); border: 1px solid rgba(239, 68, 68, 0.35); }

  .fault-code {
    display: inline-block; font-family: var(--mono); font-size: 0.82rem;
    background: var(--panel-2); border: 1px solid var(--border);
    padding: 0.15rem 0.55rem; border-radius: 6px; color: var(--fg);
  }
  .tool { font-family: var(--mono); font-size: 0.85rem; color: var(--fg); }
  .dur  { font-family: var(--mono); font-size: 0.85rem; color: var(--muted); white-space: nowrap; }
  .id   { font-family: var(--mono); font-size: 0.85rem; color: var(--fg); }

  .reason {
    font-size: 0.8rem; color: var(--muted); margin-top: 0.3rem;
  }
  .reason.fail { color: #f5a3a3; }

  .empty { color: var(--muted); }

  footer {
    margin-top: 3rem; padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    color: var(--muted); font-size: 0.8rem; font-family: var(--mono);
    display: flex; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem;
  }
  footer a { color: var(--primary); text-decoration: none; }
  footer a:hover { text-decoration: underline; }

  @media (max-width: 720px) {
    body { padding: 1.5rem 1rem 3rem; }
    .score-value { font-size: 3rem; }
    table { display: block; overflow-x: auto; }
    .meta-row { gap: 1rem; }
  }
</style>
</head>
<body>
<div class="container">

  <header class="masthead">
    <span class="brand">Ruptor</span>
    <h1 class="title">Reliability Report</h1>
  </header>

  <section class="score-card">
    <div class="score-label">Robustness Score</div>
    <div class="score-value {{scoreClass .Score}}">{{printf "%.0f" (pct .Score)}}%</div>
    <div class="score-detail">
      <strong>{{.Passed}}/{{.TotalTests}}</strong> fault scenarios handled correctly
      {{if gt .Failed 0}}&middot; <strong style="color: var(--danger);">{{.Failed}} failed</strong>{{end}}
    </div>
  </section>

  <section class="meta-row">
    <div class="meta-item"><span class="k">Agent</span><span class="v">{{.AgentName}}</span></div>
    <div class="meta-item"><span class="k">Run date</span><span class="v">{{.RunAt.Format "2006-01-02 15:04 MST"}}</span></div>
    <div class="meta-item"><span class="k">Duration</span><span class="v">{{humanDur .DurationMs}}</span></div>
    <div class="meta-item"><span class="k">Ruptor</span><span class="v">v{{.RuptorVersion}}</span></div>
  </section>

  <section>
    <h2>Experiments</h2>
    <table>
      <thead>
        <tr>
          <th style="width: 90px;">Status</th>
          <th>Test</th>
          <th>Fault</th>
          <th>Tool</th>
          <th style="width: 110px;">Duration</th>
          {{if anyJudge .Results}}<th>Judge</th>{{end}}
        </tr>
      </thead>
      <tbody>
        {{range .Results}}<tr>
          <td><span class="badge {{if .Passed}}badge-pass{{else}}badge-fail{{end}}">{{if .Passed}}PASS{{else}}FAIL{{end}}</span></td>
          <td>
            <div class="id">{{.TestID}}</div>
            {{if not .Passed}}<div class="reason fail">{{failureReason .}}</div>{{end}}
          </td>
          <td><span class="fault-code">{{.FaultType}}</span></td>
          <td class="tool">{{.Tool}}</td>
          <td class="dur">{{humanDur .DurationMs}}</td>
          {{if anyJudge $.Results}}<td>
            {{if .LLMJudgeVerdict}}<span class="id">{{.LLMJudgeVerdict}}</span>{{else}}<span class="empty">&mdash;</span>{{end}}
          </td>{{end}}
        </tr>{{end}}
      </tbody>
    </table>
  </section>

  <footer>
    <span>Generated by ruptor v{{.RuptorVersion}} &middot; <a href="https://ruptor.dev">ruptor.dev</a></span>
    <span>{{.RunAt.Format "2006-01-02 15:04:05 MST"}}</span>
  </footer>

</div>
</body>
</html>
